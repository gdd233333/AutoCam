{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocam.dev/contracts/schemas/GoldenSequence.schema.json",
  "title": "GoldenSequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "fakeClock": { "type": "boolean" },
    "stepPerFrame": { "type": "number", "exclusiveMinimum": 0 },
    "subject0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nx", "ny"],
      "properties": {
        "nx": { "$ref": "_defs.schema.json#/$defs/unit01" },
        "ny": { "$ref": "_defs.schema.json#/$defs/unit01" }
      }
    },
    "send": { "$ref": "CommandEnvelope.schema.json" },
    "withinMs": { "type": "number", "minimum": 0 },
    "nFrameWindow": { "type": "integer", "minimum": 1 },
    "expectFrame": { "type": "object" },
    "expectGuide": { "type": "object" },
    "expectEvent": { "type": "object" },
    "expectSession": { "type": "object" },
    "expectStill": { "type": "object" },
    "expectFilters": { "type": "object" },
    "expectSubjectTrajectory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "nx", "ny"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "nx": { "type": "number" },
          "ny": { "type": "number" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "send": { "$ref": "CommandEnvelope.schema.json" },
        "advanceNs": { "$ref": "_defs.schema.json#/$defs/ns" },
        "holdFrames": { "type": "integer", "minimum": 0 },
        "withinMs": { "type": "number", "minimum": 0 },
        "nFrameWindow": { "type": "integer", "minimum": 1 },
        "expectFrame": { "type": "object" },
        "expectGuide": { "type": "object" },
        "expectEvent": { "type": "object" },
        "expectSession": { "type": "object" },
        "expectStill": { "type": "object" },
        "expectFilters": { "type": "object" }
      }
    }
  }
}
