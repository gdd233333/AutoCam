{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocam.dev/contracts/schemas/ZoomBlendProfile.schema.json",
  "title": "ZoomBlendProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["hysteresisFrames", "fadeFrames", "algorithm", "breakpoints"],
  "properties": {
    "hysteresisFrames": { "type": "integer", "minimum": 1, "maximum": 30 },
    "fadeFrames": { "type": "integer", "minimum": 1, "maximum": 30 },
    "algorithm": { "type": "string", "enum": ["freeze_fade"] },
    "breakpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromLensId",
          "toLensId",
          "upSwitch",
          "downSwitch",
          "hideSwitchCropNorm"
        ],
        "properties": {
          "fromLensId": { "$ref": "_defs.schema.json#/$defs/lensId" },
          "toLensId": { "$ref": "_defs.schema.json#/$defs/lensId" },
          "upSwitch": { "$ref": "_defs.schema.json#/$defs/positiveNumber" },
          "downSwitch": { "$ref": "_defs.schema.json#/$defs/positiveNumber" },
          "hideSwitchCropNorm": { "$ref": "_defs.schema.json#/$defs/unit01" }
        }
      }
    },
    "gainMatch": {
      "type": "object",
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "cctOffsetK": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    }
  }
}
